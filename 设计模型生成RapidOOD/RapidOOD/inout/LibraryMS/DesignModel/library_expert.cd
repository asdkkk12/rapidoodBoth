@startuml
' ===================== 领域实体类（11个）=====================
class User {
	- UserID : String
	- Name : String
	- Sex : Sex
	- Password : String
	- Email : String
	- Faculty : String
	- LoanedNumber : Integer
	- BorrowStatus : BorrowStatus
	- SuspensionDays : Integer
	- OverDueFee : Real
}
class Student {
	- Major : String
	- Programme : Programme
	- RegistrationStatus : StudentStatus
}
class Faculty {
	- Position : FacultyPosition
	- Status : FacultyStatus
}
class Book {
	- CallNo : String
	- Title : String
	- Edition : String
	- Author : String
	- Publisher : String
	- Description : String
	- ISBn : String
	- CopyNum : Integer
}
class Subject {
	- Name : String
}
class BookCopy {
	- Barcode : String
	- Status : CopyStatus
	- Location : String
	- IsReserved : Boolean
}
class Loan {
	- LoanDate : Date
	- RenewDate : Date
	- DueDate : Date
	- ReturnDate : Date
	- RenewedTimes : Integer
	- IsReturned : Boolean
	- OverDueFee : Real
	- OverDue3Days : Boolean
	- OverDue10Days : Boolean
	- OverDue17Days : Boolean
	- OverDue31Days : Boolean
}
class Reserve {
	- ReserveDate : Date
	- IsReserveClosed : Boolean
}
class RecommendBook {
	- RecommendDate : Date
}
class Administrator {
	- AdminID : String
	- UserName : String
	- Password : String
}
class Librarian {
	- LibrarianID : String
	- Name : String
	- Password : String
}

' ===================== 仓储类（5个，AutoCRUD）=====================
class UserRepository {
	+ findUser ( String condition ) : User
	+ updateUser ( User object ) : boolean
	+ deleteUser ( User object ) : boolean
	+ createUser ( ) : User
}
class BookRepository {
	+ findBook ( String condition ) : Book
	+ updateBook ( Book object ) : boolean
	+ deleteBook ( Book object ) : boolean
	+ createBook ( ) : Book
}
class SubjectRepository {
	+ findSubject ( String condition ) : Subject
	+ updateSubject ( Subject object ) : boolean
	+ deleteSubject ( Subject object ) : boolean
	+ createSubject ( ) : Subject
}
class BookCopyRepository {
	+ findBookCopy ( String condition ) : BookCopy
	+ updateBookCopy ( BookCopy object ) : boolean
	+ deleteBookCopy ( BookCopy object ) : boolean
	+ createBookCopy ( ) : BookCopy
}
class LibrarianRepository {
	+ findLibrarian ( String condition ) : Librarian
	+ updateLibrarian ( Librarian object ) : boolean
	+ deleteLibrarian ( Librarian object ) : boolean
	+ createLibrarian ( ) : Librarian
}

' ===================== 业务服务类（4个，来自 remodel Services）=====================
class LibraryManagementSystem {
	+ recommendBook ( String userid, String callNo, String title, String edition, String author, String publisher, String description, String isbn ) : boolean
	+ queryBookCopy ( String barcode ) : BookCopy
	+ addBookCopy ( String callNo, String barcode, String location ) : boolean
	+ deleteBookCopy ( String barcode ) : boolean
	+ makeReservation ( String uid, String barcode ) : boolean
	+ cannelReservation ( String uid, String barcode ) : boolean
	+ borrowBook ( String uid, String barcode ) : boolean
	+ renewBook ( String uid, String barcode ) : boolean
	+ returnBook ( String barcode ) : boolean
	+ payOverDueFee ( String uid, Real fee ) : boolean
	+ checkOverDueandComputeOverDueFee ( ) : void
	+ dueSoonNotification ( ) : void
	+ countDownSuspensionDay ( ) : void
}
class ListBookHistory {
	+ listBorrowHistory ( String userid ) : Set
	+ listHodingBook ( String userid ) : Set
	+ listOverDueBook ( String userid ) : Set
	+ listReservationBook ( String userid ) : Set
	+ listRecommendBook ( String userid ) : Set
}
class SearchBook {
	+ searchBookByBarCode ( String barcode ) : Set
	+ searchBookByTitle ( String title ) : Set
	+ searchBookByAuthor ( String authorname ) : Set
	+ searchBookByISBN ( String ISBNnumber ) : Set
	+ searchBookBySubject ( String subject ) : Set
}
class ThirdPartServices {
	+ sendNotificationEmail ( String email ) : boolean
}

' ===================== 继承关系（同 library.cd）=====================
Student--|> User
Faculty--|> User
RecommendBook--|> Book

' ===================== 实体关联（14条，同 library.cd）=====================
User "*"--"1" UserRepository
Book "*"--"1" BookRepository
Subject "*"--"1" SubjectRepository
BookCopy "*"--"1" BookCopyRepository
Librarian "*"--"1" LibrarianRepository
User "LoanedUser: 1"--"LoanedBook: *" Loan
User "ReservedUser: 1"--"ReservedBook: *" Reserve
User "RecommendUser: 1"--"RecommendedBook: *" RecommendBook
Book "BookBelongs: 1"--"Copys: *" BookCopy
Book--"Subject: *" Subject
BookCopy "LoanedCopy: 1"--"LoanedRecord: *" Loan
BookCopy "ReservedCopy: 1"--"ReservationRecord: *" Reserve
Loan--"LoanLibrarian: 1" Librarian
Loan--"ReturnLibrarian: 1" Librarian

' ===================== 服务-实体关联（13条）=====================
LibraryManagementSystem--User
LibraryManagementSystem--BookCopy
LibraryManagementSystem--Book
LibraryManagementSystem--Loan
LibraryManagementSystem--Reserve
LibraryManagementSystem--RecommendBook
ListBookHistory--User
ListBookHistory--Loan
ListBookHistory--Reserve
ListBookHistory--RecommendBook
SearchBook--Book
SearchBook--BookCopy
SearchBook--Subject

enum Sex { M F }
enum BorrowStatus { NORMAL SUSPEND }
enum Programme { BACHELOR MASTER PHD }
enum StudentStatus { GRADUATED PROGRAMMING }
enum FacultyPosition { ASSISTANTPROFESSORS ASSOCIATEPROFESSOR PROFESSOR CHAIRPROFESSOR }
enum FacultyStatus { HASRETIRED INPOSITION }
enum CopyStatus { AVAILABLE INPROCESSING LIBUSEONLY ONHOLDSHELF LOANED }
@enduml
