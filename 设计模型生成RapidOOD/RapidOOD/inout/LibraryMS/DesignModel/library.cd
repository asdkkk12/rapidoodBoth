@startuml
class User {
	- UserID : String
	- Name : String
	- Sex : Sex
	- Password : String
	- Email : String
	- Faculty : String
	- LoanedNumber : Integer
	- BorrowStatus : BorrowStatus
	- SuspensionDays : Integer
	- OverDueFee : Real
}
class Student {
	- Major : String
	- Programme : Programme
	- RegistrationStatus : StudentStatus
}
class Faculty {
	- Position : FacultyPosition
	- Status : FacultyStatus
}
class Book {
	- CallNo : String
	- Title : String
	- Edition : String
	- Author : String
	- Publisher : String
	- Description : String
	- ISBn : String
	- CopyNum : Integer
}
class Subject {
	- Name : String
}
class BookCopy {
	- Barcode : String
	- Status : CopyStatus
	- Location : String
	- IsReserved : Boolean
}
class Loan {
	- LoanDate : Date
	- RenewDate : Date
	- DueDate : Date
	- ReturnDate : Date
	- RenewedTimes : Integer
	- IsReturned : Boolean
	- OverDueFee : Real
	- OverDue3Days : Boolean
	- OverDue10Days : Boolean
	- OverDue17Days : Boolean
	- OverDue31Days : Boolean
}
class Reserve {
	- ReserveDate : Date
	- IsReserveClosed : Boolean
}
class RecommendBook {
	- RecommendDate : Date
}
class Administrator {
	- AdminID : String
	- UserName : String
	- Password : String
}
class Librarian {
	- LibrarianID : String
	- Name : String
	- Password : String
}
class UserRepository {
	+ findUser ( String condition ) : User
	+ updateUser ( User object ) : boolean
	+ deleteUser ( User object ) : boolean
	+ createUser ( ) : User
}
User "*"--"1" UserRepository
class BookRepository {
	+ findBook ( String condition ) : Book
	+ updateBook ( Book object ) : boolean
	+ deleteBook ( Book object ) : boolean
	+ createBook ( ) : Book
}
Book "*"--"1" BookRepository
class SubjectRepository {
	+ findSubject ( String condition ) : Subject
	+ updateSubject ( Subject object ) : boolean
	+ deleteSubject ( Subject object ) : boolean
	+ createSubject ( ) : Subject
}
Subject "*"--"1" SubjectRepository
class BookCopyRepository {
	+ findBookCopy ( String condition ) : BookCopy
	+ updateBookCopy ( BookCopy object ) : boolean
	+ deleteBookCopy ( BookCopy object ) : boolean
	+ createBookCopy ( ) : BookCopy
}
BookCopy "*"--"1" BookCopyRepository
class LibrarianRepository {
	+ findLibrarian ( String condition ) : Librarian
	+ updateLibrarian ( Librarian object ) : boolean
	+ deleteLibrarian ( Librarian object ) : boolean
	+ createLibrarian ( ) : Librarian
}
Librarian "*"--"1" LibrarianRepository
Student--|> User
Faculty--|> User
RecommendBook--|> Book
User "LoanedUser: 1"--"LoanedBook: *" Loan
User "ReservedUser: 1"--"ReservedBook: *" Reserve
User "RecommendUser: 1"--"RecommendedBook: *" RecommendBook
Book "BookBelongs: 1"--"Copys: *" BookCopy
Book--"Subject: *" Subject
BookCopy "LoanedCopy: 1"--"LoanedRecord: *" Loan
BookCopy "ReservedCopy: 1"--"ReservationRecord: *" Reserve
Loan--"LoanLibrarian: 1" Librarian
Loan--"ReturnLibrarian: 1" Librarian
enum Sex {
	M
	F
}
enum BorrowStatus {
	NORMAL
	SUSPEND
}
enum Programme {
	BACHELOR
	MASTER
	PHD
}
enum StudentStatus {
	GRADUATED
	PROGRAMMING
}
enum FacultyPosition {
	ASSISTANTPROFESSORS
	ASSOCIATEPROFESSOR
	PROFESSOR
	CHAIRPROFESSOR
}
enum FacultyStatus {
	HASRETIRED
	INPOSITION
}
enum CopyStatus {
	AVAILABLE
	INPROCESSING
	LIBUSEONLY
	ONHOLDSHELF
	LOANED
}
@enduml