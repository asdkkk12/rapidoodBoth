MicroServiceModel Trainticket {
	MicroService CustomerService {
		ProvidedInterface cancelTicket{
			[Operation]
			cancelTicket
			CallChain cancelTicket {
				service  :  {
					Message 1 to EmailService {
						operation drawbackMoney
					}
				}
				service EmailService : EmailService {
					Message 2 {
						operation order_cancel_success
					}
				}
			}
		}
		ProvidedInterface getQuickestRoutes{
			[Operation]
			getQuickestRoutes
		}
		ProvidedInterface getTransferResult{
			[Operation]
			getTransferResult
		}
		ProvidedInterface payDifference{
			[Operation]
			payDifference
		}
		ProvidedInterface createAccout{
			[Operation]
			createAccout
		}
		ProvidedInterface getByQuickestTravel{
			[Operation]
			getByQuickestTravel
		}
		ProvidedInterface getMinStopStations{
			[Operation]
			getMinStopStations
		}
		ProvidedInterface getTrainFood{
			[Operation]
			getTrainFood
		}
		ProvidedInterface pay{
			[Operation]
			pay
		}
		ProvidedInterface preserve{
			[Operation]
			preserve
			CallChain preserve {
				service AdminService : AdminService {
					Message 1 to AdminService {
						operation securityInfoCheck
					}
				}
				service AdminService : AdminService {
					Message 2 to TrainStaffService {
						operation distributeSeat
					}
				}
				service TrainStaffService : TrainStaffService {
					Message 3 to AdminService {
						operation manageFood
					}
				}
				service AdminService : AdminService {
					Message 4 to EmailService {
						operation manageConsign
					}
				}
				service EmailService : EmailService {
					Message 5 {
						operation order_create_success
					}
				}
			}
		}
		ProvidedInterface getByCheapestTravel{
			[Operation]
			getByCheapestTravel
		}
		ProvidedInterface getByMinStation{
			[Operation]
			getByMinStation
			CallChain getByMinStation {
				service  :  {
					Message 1 {
						operation getMinStopRoutes
					}
				}
			}
		}
		ProvidedInterface getLeftTicketOfInterval{
			[Operation]
			getLeftTicketOfInterval
		}
		ProvidedInterface getCheapestRoutes{
			[Operation]
			getCheapestRoutes
		}
		ProvidedInterface addMoney{
			[Operation]
			addMoney
		}
		ProvidedInterface queryForTravel{
			[Operation]
			queryForTravel
		}
		ProvidedInterface rebook{
			[Operation]
			rebook
			CallChain rebook {
				service AdminService : AdminService {
					Message 1 to EmailService {
						operation distributeSeat
					}
				}
				service EmailService : EmailService {
					Message 2 {
						operation order_changed_success
					}
				}
			}
		}
		ProvidedInterface getPriceByWeightAndRegion{
			[Operation]
			getPriceByWeightAndRegion
		}
		ProvidedInterface getFoodStores{
			[Operation]
			getFoodStores
		}
		ProvidedInterface drawBack{
			[Operation]
			drawBack
		}
		ProvidedInterface executeTicket{
			[Operation]
			executeTicket
			CallChain executeTicket {
				service  :  {
					Message 1 {
						operation excuteOrder
					}
				}
			}
		}
		ProvidedInterface managePriceInfo{
			[Operation]
			createPriceInfo
			queryPriceInfo
			updatePriceInfo
			modifyPriceInfo
		}
		ProvidedInterface manageAssurance{
			[Operation]
			createAssurance
			queryAssurance
			updateAssurance
			modifyAssurance
		}
		ProvidedInterface manageTripResponse{
			[Operation]
			createTripResponse
			queryTripResponse
			updateTripResponse
			modifyTripResponse
		}
		ProvidedInterface manageOrder{
			[Operation]
			createOrder
			queryOrder
			updateOrder
			modifyOrder
		}
		ProvidedInterface manageBalance{
			[Operation]
			createBalance
			queryBalance
			updateBalance
			modifyBalance
		}
		ProvidedInterface manageTripId{
			[Operation]
			createTripId
			queryTripId
			updateTripId
			modifyTripId
		}
		RequiredInterface manageAssuranceTypeBean
		RequiredInterface managePlainAssurance
		RequiredInterface manageUser
		RequiredInterface manageOrderInfo
		RequiredInterface manageFood
		RequiredInterface manageAccout
		RequiredInterface manageTrain
		RequiredInterface manageRoute
		RequiredInterface manageTrip
		RequiredInterface manageConsignRecord
		RequiredInterface drawbackMoney 
		RequiredInterface order_cancel_success 
		RequiredInterface excuteOrder 
		RequiredInterface securityInfoCheck 
		RequiredInterface distributeSeat 
		RequiredInterface manageConsign
		RequiredInterface order_create_success 
		RequiredInterface order_changed_success 
		RequiredInterface getMinStopRoutes 
		DomainModel CustomerService {
			@AutoCRUD Entity Assurance {
				Id : String
				OrderId : String
				Type : Integer
				[Refer]
			}
			 Entity TripId {
				Type : Integer
				Number : String
				[Refer]
			}
			@AutoCRUD Entity Order {
				Id : String
				BoughtData : String
				TravelDate : String
				TravelTime : String
				AccoutId : String
				ContactsName : String
				DocumentType : Integer
				ContactsDocumentNumber : String
				TrainNumber : String
				CoachNumber : Integer
				SeatClass : Integer
				SeatNumber : String
				From : String
				To : String
				Status : Integer
				Price : String
				[Refer]
				AlterInfo : OrderAlterInfo  Association
			}
			 Entity TravelAdvanceResultUnit {
				TripId : String
				TrainType : String
				StartStation : String
				EndStation : String
				StopStations : Set<String>
				PriceForSecondClassSet : String
				NumberOfRestTicketSecondSeat : Integer
				StartTime : String
				EndTime : String
				[Refer]
			}
			@AutoCRUD Entity TrainFood {
				Id : String
				TripId : String
				FoodList : Set<Food>
				[Refer]
			}
			 Entity Balance {
				UserId : String
				Balance : String
				[Refer]
			}
			@AutoCRUD Entity OrderAlterInfo {
				AccoutId : String
				PreviousOrderId : String
				LoginToken : String
				NewOrderInfo : Order
				[Refer]
				NewOrderInfo : Order  Association
			}
			 Entity PriceInfo {
				Id : String
				TrainType : String
				RouteId : String
				BasicPriceRate : Real
				FirstClassPriceRate : Real
				[Refer]
			}
			 Entity TripAllDetail {
				Status : Boolean
				Message : String
				TripResponse : TripResponse
				Trip : Trip
				[Refer]
				TripResponse : TripResponse  Association
			}
			 Entity TripResponse {
				TripId : TripId
				TrainName : String
				RouteId : String
				StartStationName : String
				StationsName : String
				TerminalStationName : String
				StartTime : String
				EndTime : String
				EconomyClass : Integer
				ConfortClass : Integer
				PriceForEconomyClass : String
				PriceForConfortClass : String
				[Refer]
				TripId : TripId  Association
			}
			 Entity Travel {
				Trip : Trip
				StartPlace : String
				EndPlace : String
				DepartureTime : String
				[Refer]
			}
			 Entity InsertConsignRecordResult {
				Status : Boolean
				Message : String
				[Refer]
			}
		}
	}
	MicroService TrainStaffService {
		ProvidedInterface manageFoodDelivery{
			[Operation]
