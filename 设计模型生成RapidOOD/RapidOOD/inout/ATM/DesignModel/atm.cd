@startuml
class BankCard {
	- CardID : Integer
	- CardStatus : CardStatus
	- Catalog : CardCatalog
	- Password : Integer
	- Balance : Real
}
class User {
	- UserID : Integer
	- Name : String
	- Address : String
}
class BankCardRepository {
	+ findBankCard ( String condition ) : BankCard
	+ updateBankCard ( BankCard object ) : boolean
	+ deleteBankCard ( BankCard object ) : boolean
	+ createBankCard ( ) : BankCard
}
BankCard "*"--"1" BankCardRepository
class UserRepository {
	+ findUser ( String condition ) : User
	+ updateUser ( User object ) : boolean
	+ deleteUser ( User object ) : boolean
	+ createUser ( ) : User
}
User "*"--"1" UserRepository
BankCard "OwnedCard: *"--"BelongedUser: 1" User
enum CardStatus {
	NORMAL
	SUSPEND
	CANNEL
}
enum CardCatalog {
	CREDIT
	DESPOSIT
}
@enduml